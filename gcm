def cfg_bool(value):
    """True/False tu gia tri config (chap nhan ca bool va chuoi kieu 'yes')."""
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("1", "true", "yes", "on")


def coerce_config_value(key, value):
    """Ep value ve dung kieu khai bao trong schema.

    Tra (ok, value_da_ep, loi). Value sai kieu / sai lua chon bi tu choi kem
    thong bao de nguoi dung sua, thay vi am tham chay sai.
    """
    spec = CONFIG_SCHEMA[key]
    if spec["type"] is bool:
        if isinstance(value, bool):
            return True, value, ""
        s = str(value).strip().lower()
        if s in ("1", "true", "yes", "on"):
            return True, True, ""
        if s in ("0", "false", "no", "off"):
            return True, False, ""
        return False, None, f"'{key}' can true/false, nhan '{value}'"
    if isinstance(value, bool) or value is None:
        return False, None, f"'{key}' can mot chuoi, nhan '{value}'"
    s = str(value).strip()
    choices = spec.get("choices")
    if choices:
        if s.lower() not in choices:
            return False, None, (f"'{key}' chi nhan {' | '.join(choices)}, "
                                 f"nhan '{s}'")
        return True, s.lower(), ""
    return True, s, ""


def read_config_raw(path=None):
    """Doc nguyen si config.json (giu ca key ghi chu). {} neu thieu/hong."""
    path = path or CONFIG_PATH
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        return {}
    return raw if isinstance(raw, dict) else {}


def read_config_file(path=None):
    """Doc config.json -> (overrides cua nguoi dung, list canh bao).

    Key bat dau bang '//' hoac '_' la ghi chu (JSON khong co comment) nen bo
    qua. Key la / gia tri sai kieu -> canh bao chu khong lam gcm chet.
    """
    path = path or CONFIG_PATH
    if not os.path.exists(path):
        return {}, []
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            raw = json.load(f)
    except OSError as e:
        return {}, [f"khong doc duoc {path}: {e}"]
    except ValueError as e:
        return {}, [f"{path} khong phai JSON hop le ({e}) -> dung mac dinh"]
    if not isinstance(raw, dict):
        return {}, [f"{path} phai la mot object JSON dang {{...}}"]
    out, warn = {}, []
    for k, v in raw.items():
        if k.startswith("//") or k.startswith("_"):
            continue
        key = k.strip().lower()
        if key == "groq_api_key":  # ten cu
            key = "api_key"
        if key not in CONFIG_SCHEMA:
            warn.append(f"config.json: bo qua key la '{k}'")
            continue
        if v is None or v == "":  # de trong = chua dat -> theo mac dinh
            continue
        ok, val, msg = coerce_config_value(key, v)
        if not ok:
            warn.append(f"config.json: {msg}")
            continue
        out[key] = val
    return out, warn


def env_config():
    """Overrides lay tu bien moi truong (uu tien cao hon file config)."""
    out = {}
    for key, name in CONFIG_ENV.items():
        raw = os.environ.get(name, "").strip()
        if not raw:
            continue
        ok, val, _ = coerce_config_value(key, raw)
        if ok:
            out[key] = val
    return out


def load_config():
    """Tra config hieu luc = mac dinh <- file config.json <- env.

    Dong thoi cap nhat USER_CONFIG (phan nguoi dung that su ghi trong file)
    va CONFIG_WARNINGS, de `gcm config` noi duoc tung key den tu dau.
    """
    global USER_CONFIG, CONFIG_WARNINGS
    USER_CONFIG, CONFIG_WARNINGS = read_config_file()
    return {**CONFIG_DEFAULTS, **USER_CONFIG, **env_config()}


def cfg(key):
    """Gia tri hieu luc cua mot key config (luon co, khong bao gio KeyError)."""
    return CONFIG.get(key, CONFIG_DEFAULTS[key])


def config_source(key):
    """Nguon dang cung cap gia tri: 'env GROQ_API_KEY' | 'file' | 'mac dinh'."""
    env_name = CONFIG_ENV.get(key)
    if env_name and os.environ.get(env_name, "").strip():
        return f"env {env_name}"
    if key in USER_CONFIG:
        return "file"
    return "mac dinh"


def config_hint(key):
    """Dong ghi chu '//key' cho mot key: mo ta + lua chon + mac dinh built-in."""
    spec = CONFIG_SCHEMA[key]
    choices = spec.get("choices")
    text = spec["help"] + (f"  ({' | '.join(choices)})" if choices else "")
    return f"{text}  - mac dinh: {json.dumps(spec['default'], ensure_ascii=False)}"


def config_skeleton(overrides=None):
    """Khung config.json: ghi chu DU moi key, gia tri CHI cho key ban da doi.

    Nho vay mo file ra la thay het cac truong co the chinh (kem mac dinh cua
    tung truong), ma van khong ghim mac dinh nao vao file.
    """
    overrides = overrides or {}
    data = dict(CONFIG_HEADER)
    for k in CONFIG_SCHEMA:
        data[f"//{k}"] = config_hint(k)
        if k in overrides:
            data[k] = overrides[k]
    return data


def order_config(data):
    """Sap xep lai file cho de doc: ghi chu chung -> tung cap '//key' + key."""
    out = {}
    for k, v in data.items():  # ghi chu chung (khong gan voi key nao) len dau
        if k.startswith("//") and k[2:].strip().lower() not in CONFIG_SCHEMA:
            out[k] = v
    for k in CONFIG_SCHEMA:  # moi key: dong mo ta ngay tren gia tri
        if f"//{k}" in data:
            out[f"//{k}"] = data[f"//{k}"]
        if k in data:
            out[k] = data[k]
    for k, v in data.items():  # key la cua nguoi dung: giu, khong xoa gium
        out.setdefault(k, v)
    return out


def write_config_file(data, path=None):
    """Ghi dict ra config.json (indent 2, da sap xep cho de doc)."""
    path = path or CONFIG_PATH
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(order_config(data), f, indent=2, ensure_ascii=False)
        f.write("\n")


def _key_aliases(key):
    return {key, "groq_api_key"} if key == "api_key" else {key}


def save_config(key, value):
    """Ghi mot key vao config.json roi nap lai CONFIG trong bo nho.

    Gia tri trung mac dinh built-in se bi XOA khoi file (file chi giu nhung
    gi ban da doi). Cac key khac va dong ghi chu duoc giu nguyen.
    Raise KeyError/ValueError neu key hoac value khong hop le.
    """
    global CONFIG
    key = str(key).strip().lower()
    if key not in CONFIG_SCHEMA:
        raise KeyError(f"key config khong hop le: {key}")
    ok, val, msg = coerce_config_value(key, value)
    if not ok:
        raise ValueError(msg)
    raw = read_config_raw()
    for k in [k for k in raw if k.strip().lower() in _key_aliases(key)]:
        raw.pop(k)
    if val != CONFIG_DEFAULTS[key]:
        raw[key] = val
    write_config_file(raw)
    CONFIG = load_config()


def unset_config(key):
    """Xoa key khoi config.json -> quay ve mac dinh. True neu file co key do."""
    global CONFIG
    key = str(key).strip().lower()
    if key not in CONFIG_SCHEMA:
        raise KeyError(f"key config khong hop le: {key}")
    raw = read_config_raw()
    hit = [k for k in raw if k.strip().lower() in _key_aliases(key)]
    for k in hit:
        raw.pop(k)
    if hit:
        write_config_file(raw)
        CONFIG = load_config()
    return bool(hit)


def prune_default_config():
    """Xoa khoi config.json cac key co gia tri y het mac dinh built-in.

    Giu dung tinh than "file chi chua nhung gi ban doi": doi mac dinh o ban
    sau la an ngay, khong bi gia tri cu ghim lai. Tra list key da xoa.
    """
    raw = read_config_raw()
    if not raw:
        return []
    pruned = []
    for k in list(raw):
        key = k.strip().lower()
        if key not in CONFIG_SCHEMA:
            continue
        if raw[k] == "" or raw[k] is None:
            continue  # o de trong san cho nguoi dung dien - giu nguyen
        ok, val, _ = coerce_config_value(key, raw[k])
        if ok and val == CONFIG_DEFAULTS[key]:
            raw.pop(k)
            pruned.append(key)
    if pruned:
        try:
            write_config_file(raw)
        except OSError:
            return []
    return pruned


def parse_legacy_config(path):
    """Doc file config kieu cu ('key = value', hoac ca file la mot api key)."""
    out = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            k, _, v = line.partition("=")
            k, v = k.strip().lower(), v.strip()
            if k == "groq_api_key":
                k = "api_key"
            if k in CONFIG_SCHEMA and v:
                ok, val, _ = coerce_config_value(k, v)
                if ok:
                    out[k] = val
        else:
            out["api_key"] = line  # file cu: ca file la mot api key
    return out


def backup_path(path):
    """Duong dan backup con trong: config.migrated, .migrated.1, .migrated.2...

    KHONG BAO GIO de ban migrate sau de len ban truoc - file cu co the la ban
    duy nhat con giu api key cua nguoi dung.
    """
    base = path + ".migrated"
    if not os.path.exists(base):
        return base
    n = 1
    while os.path.exists(f"{base}.{n}"):
        n += 1
    return f"{base}.{n}"


def migrate_legacy_config():
    """Chuyen file cu ~/.config/gcm/config (key = value) sang config.json.

    Chi chay khi chua co config.json. Key trung mac dinh bi bo di. File cu
    duoc doi ten thanh 'config.migrated' (khong de len backup da co) de lan
    sau khong doc lai. Tra list key da chuyen.
    """
    if os.path.exists(CONFIG_PATH) or not os.path.exists(LEGACY_CONFIG_PATH):
        return []
    kept = {k: v for k, v in parse_legacy_config(LEGACY_CONFIG_PATH).items()
            if v != CONFIG_DEFAULTS[k]}
    try:
        data = config_skeleton(kept)
        data.setdefault("api_key", "")  # luon chua san cho de dan key vao
        write_config_file(data)
        os.replace(LEGACY_CONFIG_PATH, backup_path(LEGACY_CONFIG_PATH))
    except OSError:
        return []
    return sorted(kept)


