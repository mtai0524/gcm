_KEY_ESC = {
    "[A": "up", "[B": "down", "OA": "up", "OB": "down",
    "[H": "home", "[F": "end", "OH": "home", "OF": "end",
    "[1~": "home", "[4~": "end", "[7~": "home", "[8~": "end",
    "[5~": "pgup", "[6~": "pgdn",
}


def read_key():
    """Doc 1 phim, tra token: up/down/pgup/pgdn/home/end/space/enter/all/
    invert/diff/quit hoac '' (phim khong dung toi)."""
    if os.name == "nt":
        import msvcrt
        ch = msvcrt.getch()
        if ch in (b"\x00", b"\xe0"):  # phim dac biet: prefix roi ma phim
            return _KEY_WIN.get(msvcrt.getch(), "")
        return _KEY_CHARS.get(ch.decode("latin-1", "ignore"), "")
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch != "\x1b":
            return _KEY_CHARS.get(ch, "")
        # ESC don (khong co byte theo sau trong ~50ms) = thoat; con lai la
        # chuoi mui ten/Home/End/PgUp... doc den byte ket thuc (chu cai / ~).
        seq = ""
        while select.select([fd], [], [], 0.05)[0]:
            seq += sys.stdin.read(1)
            if seq[-1].isalpha() or seq[-1] == "~":
                break
            if len(seq) > 6:
                break
        if not seq:
            return "quit"
        return _KEY_ESC.get(seq, "")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def term_size():
    """(cot dung duoc, dong) cua terminal; fallback 80x24 khi khong hoi duoc.

    Cot dung duoc = cot that - 1: ghi dung toi cot cuoi cung lam conhost tu
    xuong dong -> du 1 dong -> troi ca man hinh. Chua toi 1 cot la an toan.
    """
    size = shutil.get_terminal_size(fallback=(80, 24))
    return max(40, size.columns - 1), max(10, size.lines)


def char_width(ch):
    """Do rong hien thi cua 1 ky tu (CJK/emoji chiem 2 cot, ky tu dieu khien 0)."""
    if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Cc"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s):
    return sum(char_width(ch) for ch in s)


def clip_text(s, width, ellipsis="…"):
    """Cat chuoi (khong mau) vua `width` cot, them dau '…' neu bi cat."""
    if text_width(s) <= width:
        return s
    keep = max(0, width - text_width(ellipsis))
    out, w = [], 0
    for ch in s:
        cw = char_width(ch)
        if w + cw > keep:
            break
        out.append(ch)
        w += cw
    return "".join(out) + ellipsis


def pad_text(s, width):
    """Dem khoang trang ben phai cho du `width` cot (chuoi khong mau)."""
    return s + " " * max(0, width - text_width(s))


def shorten_path(path, width):
    """Rut gon duong dan vua `width` cot, giu ten file: 'src/…/Chart.razor'."""
    if text_width(path) <= width:
        return path
    parts = path.replace("\\", "/").split("/")
    name = parts[-1]
    if len(parts) == 1 or text_width(name) + 2 >= width:
        return clip_text(path, width)
    # Giu cang nhieu thu muc dau cang tot, roi '…/' roi ten file
    head = ""
    for part in parts[:-1]:
        cand = head + part + "/"
        if text_width(cand) + 2 + text_width(name) > width:
            break
        head = cand
    return head + "…/" + name


class _Screen:
    """Alternate screen buffer + an con tro; thoat la tra terminal nhu cu.

    Dung `with _Screen():` de moi duong thoat (Enter, q, Ctrl+C, loi) deu don
    dep man hinh, khong de lai rac trong scrollback. Long nhau (pager mo tu
    trong TUI) thi chi lop ngoai cung bat/tat man hinh.
    """
    depth = 0

    def __enter__(self):
        if _Screen.depth == 0:
            sys.stdout.write("\033[?1049h\033[?25l\033[H\033[2J")
            sys.stdout.flush()
        _Screen.depth += 1
        return self

    def __exit__(self, *exc):
        _Screen.depth -= 1
        if _Screen.depth == 0:
            sys.stdout.write("\033[?25h\033[?1049l")
            sys.stdout.flush()
        return False

    @classmethod
    def nested(cls):
        return cls()

    @staticmethod
    def render(lines):
        """Ve lai toan bo man hinh tu goc tren-trai (moi dong tu xoa phan du)."""
        sys.stdout.write("\033[H" + "\n".join("\033[2K" + ln for ln in lines)
                         + "\033[J")
        sys.stdout.flush()


def _scroll_window(cursor, top, total, height):
    """Doi `top` de `cursor` luon nam trong cua so [top, top+height)."""
    if total <= height:
        return 0
    if cursor < top:
        top = cursor
    elif cursor >= top + height:
        top = cursor - height + 1
    return max(0, min(top, total - height))


def classify_diff(text):
    """Text diff (khong mau) -> [(loai, dong)] de to mau / hien thi."""
    def kind(ln):
        if ln.startswith("+++") or ln.startswith("---"):
            return "head"
        if ln.startswith("@@"):
            return "hunk"
        if ln.startswith("+"):
            return "add"
        if ln.startswith("-"):
            return "del"
        if ln.startswith("diff ") or ln.startswith("index "):
            return "meta"
        return "ctx"
    return [(kind(ln), ln.expandtabs(4))
            for ln in text.rstrip("\n").splitlines()]


def diff_entries(code, path):
    """Diff cua 1 file de hien thi: (tieu de, [(loai, dong)]).

    loai: add | del | hunk | head | meta | ctx | note. TUI to mau bang ANSI,
    GUI to mau bang tag - cung mot nguon du lieu.
    """
    if code == "??":
        full = os.path.join(REPO_ROOT or ".", path)
        try:
            with open(full, "rb") as f:
                raw = f.read(200_000)
        except OSError as e:
            return f"{path} (file moi)", [("note", f"(khong doc duoc: {e})")]
        if b"\0" in raw[:8000]:
            return f"{path} (file moi)", [("note", "(file nhi phan)")]
        body = raw.decode("utf-8", "replace").splitlines()
        entries = [("add", "+" + ln.expandtabs(4)) for ln in body] or \
            [("note", "(file rong)")]
        if len(raw) >= 200_000:
            entries.append(("note", "... (file qua lon, chi hien phan dau)"))
        return f"{path} (file moi, {len(body)} dong)", entries

    out = run_git(["diff", "--no-color", "HEAD", "--", path], check=False)
    entries = classify_diff(out)
    return f"diff {path}", entries or [
        ("note", "(khong co thay doi so voi HEAD)")]


_DIFF_COLORS = {"add": "32", "del": "31", "hunk": "36", "head": "1",
                "meta": "90", "note": "90"}


def diff_lines(code, path):
    """Noi dung xem trong pager TUI: (tieu de, [dong da to mau ANSI])."""
    title, entries = diff_entries(code, path)
    return title, [c(ln, _DIFF_COLORS[k]) if k in _DIFF_COLORS else ln
                   for k, ln in entries]


def clip_ansi(s, width):
    """Cat chuoi CO ma mau vua `width` cot; ma mau khong tinh do rong."""
    out, w, i = [], 0, 0
    while i < len(s):
        if s[i] == "\033":  # copy nguyen chuoi escape \033[...m
            j = s.find("m", i)
            if j == -1:
                break
            out.append(s[i:j + 1])
            i = j + 1
            continue
        cw = char_width(s[i])
        if w + cw > width:
            out.append("\033[0m")
            return "".join(out)
        out.append(s[i])
        w += cw
        i += 1
    return "".join(out)


def pager(title, lines):
    """Xem mot khoi text ngay trong terminal: cuon ↑↓/PgUp/PgDn/Home/End.

    Tu mo alternate screen; neu dang o trong TUI (da mo san) thi dung chung.
    """
    top = 0
    with _Screen.nested():
        while True:
            cols, rows = term_size()
            height = rows - 2  # 1 dong tieu de + 1 dong huong dan
            top = max(0, min(top, len(lines) - height))
            end = min(len(lines), top + height)
            pos = f"{top + 1}-{end}/{len(lines)}" if lines else "0/0"
            screen = [
                clip_ansi(c(f" {title}", "1") + c(f"  {pos}", "90"), cols),
            ]
            screen += [clip_ansi(" " + ln, cols) for ln in lines[top:end]]
            screen += [""] * (height - (end - top))
            screen.append(clip_ansi(
                c(" ↑↓ cuon . PgUp/PgDn trang . Home/End . q/d/Enter quay lai",
                  "90"), cols))
            _Screen.render(screen)

            key = read_key()
            if key in ("quit", "diff", "enter"):
                return
            if key == "up":
                top -= 1
            elif key == "down":
                top += 1
            elif key == "pgup":
                top -= height
            elif key in ("pgdn", "space"):
                top += height
            elif key == "home":
                top = 0
            elif key == "end":
                top = len(lines)


def diff_pager(code, path):
    """Xem diff cua 1 file ngay trong TUI (pager cuon duoc)."""
    title, lines = diff_lines(code, path)
    pager(title, lines)


def tui_select(default_all=False):
    """Bo chon file kieu TUI: ↑↓ di chuyen, space tick, d xem diff, Enter xong.

    Chay tren alternate screen (khong de lai rac), tu cuon khi danh sach dai
    hon man hinh, duong dan dai duoc rut gon theo do rong terminal.
    Ket thuc: stage DUNG nhung file da tick (file da stage san ma bo tick se
    duoc unstage). Tra True neu co stage, False neu khong co gi de chon.
    """
    items = changed_files()
    if not items:
        return False
    n = len(items)
    branch, ahead = branch_status()
    selected = {i for i, (code, _) in enumerate(items) if code[0] not in " ?"}
    if default_all and not selected:
        selected = set(range(n))
    cursor, top, notice = 0, 0, ""

    def draw():
        nonlocal top
        cols, rows = term_size()
        height = max(3, rows - 4)  # tieu de + ke + ... + list + ke + huong dan
        top = _scroll_window(cursor, top, n, height)
        end = min(n, top + height)

        head = f" [{branch}" + (f" ↑{ahead}" if ahead else "") + "]"
        title = c(head, "36") + c(f" Chon file de stage", "1") \
            + c(f"  {len(selected)}/{n} da tick", "32" if selected else "90")
        screen = [clip_ansi(title, cols), c("─" * cols, "90")]
        label_w = 9  # do rong nhan trang thai (status_label)
        path_w = cols - (3 + 4 + label_w + 2)  # ' > ' + '[x] ' + nhan + le
        for i in range(top, end):
            code, path = items[i]
            box = c("[x]", "32") if i in selected else c("[ ]", "90")
            pointer = c(">", "36;1") if i == cursor else " "
            name = shorten_path(path, path_w)
            line = f" {pointer} {box} {status_label(code)} " + (
                c(name, "1") if i == cursor else name)
            screen.append(clip_ansi(line, cols))
        screen += [""] * (height - (end - top))
        more = []
        if top > 0:
            more.append(f"↑ {top} file nua")
        if end < n:
            more.append(f"↓ {n - end} file nua")
        screen.append(c("─" * cols, "90") if not more else
                      clip_ansi(c(" " + "   ".join(more), "33"), cols))
        hint = (" ↑↓ chon . space tick . a tat ca . i dao . d diff . "
                "Enter xong . q huy")
        screen.append(clip_ansi(
            c(notice, "31;1") if notice else c(hint, "90"), cols))
        _Screen.render(screen)

    with _Screen():
        while True:
            draw()
            key = read_key()
            notice = ""
            if key == "up":
                cursor = (cursor - 1) % n
            elif key == "down":
                cursor = (cursor + 1) % n
            elif key == "pgup":
                cursor = max(0, cursor - (term_size()[1] - 4))
            elif key == "pgdn":
                cursor = min(n - 1, cursor + (term_size()[1] - 4))
            elif key == "home":
                cursor = 0
            elif key == "end":
                cursor = n - 1
            elif key == "space":
                selected ^= {cursor}
            elif key == "all":
                selected = set() if len(selected) == n else set(range(n))
            elif key == "invert":
                selected = set(range(n)) - selected
            elif key == "diff":
                diff_pager(*items[cursor])
            elif key == "enter":
                if selected:
                    break
                notice = " chua tick file nao - space de tick, q de huy"
            elif key == "quit":
                selected = None
                break

    if selected is None:
        print("Da huy.")
        sys.exit(0)
    paths = [items[i][1] for i in sorted(selected)]
    stage_files(paths, [p for _, p in items])
    print(c(f"da stage {len(paths)} file:", "32"),
          c(", ".join(paths) if len(paths) <= 6 else
            ", ".join(paths[:6]) + f", ... (+{len(paths) - 6})", "90"))
    return True


SKIP_NAMES = {
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock",
    "Cargo.lock", "composer.lock", "Gemfile.lock", "go.sum", "bun.lockb",
    "packages.lock.json",
}
SKIP_SUFFIXES = (".min.js", ".min.css", ".map", ".lock")


def is_noise_file(path):
    """File lockfile/generated: van commit nhung khong gui noi dung cho LLM."""
    name = os.path.basename(path)
    return name in SKIP_NAMES or name.endswith(SKIP_SUFFIXES)


def file_diff(path, from_head=False):
    if from_head:
        return run_git(["show", "--format=", "HEAD", "--", path])
    return run_git(["diff", "--staged", "--", path])


def file_stat(path, from_head=False):
    if from_head:
        return run_git(["show", "--format=", "--stat", "HEAD", "--", path])
    return run_git(["diff", "--staged", "--stat", "--", path])


def smart_diff(files, from_head=False):
    """Gom diff tung file theo budget MAX_DIFF_CHARS.

    - lockfile/generated/binary -> chi ghi ten vao 'skipped' (khong gui noi dung)
    - file qua lon so voi budget con lai -> thay bang --stat cua file do
    Tra (diff_text, skipped_list, truncated_flag).
    """
    parts, skipped = [], []
    remaining = MAX_DIFF_CHARS
    truncated = False
    for f in files:
        if is_noise_file(f):
            skipped.append(f"{f} (lockfile/generated)")
            continue
        d = file_diff(f, from_head)
        if "\nBinary files " in "\n" + d:
            skipped.append(f"{f} (binary)")
            continue
        if len(d) > remaining:
            stat = file_stat(f, from_head).strip()
            entry = f"(diff for {f} too large - stats only)\n{stat}\n\n"
            truncated = True
            if len(entry) <= remaining:
                parts.append(entry)
                remaining -= len(entry)
            else:
                skipped.append(f"{f} (too large)")
            continue
        parts.append(d)
        remaining -= len(d)
    return "".join(parts), skipped, truncated


def build_prompt(diff, files, vietnamese, hint=None, skipped=None):
    files_list = "\n".join(files) if files else "(unknown)"
    system = get_system_prompt(vietnamese)
    hint_block = (
        f"Extra context from the author (use it, it is important):\n{hint}\n\n"
        if hint else ""
    )
    skipped_block = (
        "Also changed, but content omitted (lockfiles/binary - mention "
        "briefly in the body only if relevant):\n"
        + "\n".join(f"- {s}" for s in skipped) + "\n\n"
        if skipped else ""
    )
    user = (
        f"{hint_block}"
        f"{skipped_block}"
        f"Changed files:\n{files_list}\n\n"
        f"Git diff (staged):\n{diff}"
    )
    return system, user


def call_groq(api_key, system, user, model=None, temperature=0.3):
    payload = {
        "model": model or cfg("model"),
        "temperature": temperature,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        API_URL,
        data=data,
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": f"gcm/{VERSION}",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            body = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "ignore")
        hint = None
        if e.code == 429:
            hint = ("het quota/rate limit. Doi mot chut hoac xem: "
                    "https://console.groq.com/settings/limits")
        elif e.code in (401, 403):
            hint = ("key sai hoac het han. Tao key moi: "
                    "https://console.groq.com/keys")
        elif e.code == 404:
            hint = (f"model '{payload['model']}' khong ton tai. Xem model "
                    "list: https://console.groq.com/docs/models")
        fail(f"Groq API HTTP {e.code}: {detail[:300]}", hint)
    except urllib.error.URLError as e:
        fail(f"loi mang: {e.reason}",
             "kiem tra ket noi internet/proxy roi thu lai.")
    try:
        msg = (body["choices"][0]["message"].get("content") or "").strip()
    except (KeyError, IndexError, AttributeError):
        fail("phan hoi API khong hop le: " + json.dumps(body)[:300])
    if not msg:
        fail("model tra ve noi dung rong: " + json.dumps(body)[:300])
    if msg.startswith("```"):
        lines = msg.splitlines()
        lines = [ln for ln in lines if not ln.strip().startswith("```")]
        msg = "\n".join(lines).strip()
    return msg


def generate_message(files, vietnamese, hint, api_key, model,
                     temperature=0.3):
    """Tao commit message tu cac file DA stage (khong UI, khong sys.exit).

    Goi smart_diff -> build_prompt -> call_groq. Raise ValueError neu thieu file.
    """
    if not files:
        raise ValueError("chua chon file nao")
    diff, skipped, _truncated = smart_diff(files)
    system, user = build_prompt(diff, files, vietnamese, hint, skipped)
    return call_groq(api_key, system, user, model, temperature)


def add_coauthor(message):
    """Them trailer 'Co-authored-by: ...' vao cuoi message neu chua co.

    Lay tu config "coauthor" (vd: 'Ten <email>'), mac dinh DEFAULT_COAUTHOR.
    coauthor = off|none|false -> khong them. Tra message da co trailer.
    """
    raw = cfg("coauthor").strip()
    if raw.lower() in ("off", "none", "false", "no", ""):
        return message
    trailer = f"Co-authored-by: {raw}"
    if trailer.lower() in message.lower():
        return message
    return message.rstrip() + "\n\n" + trailer + "\n"


def commit_with_message(message, amend=False):
    """Commit voi message; tra returncode (0 = ok) de con push sau do."""
    args = ["git", "commit", "-F", "-"]
    if amend:
        args.append("--amend")
    res = subprocess.run(
        args, input=message, text=True,
        encoding="utf-8", errors="replace",
        cwd=REPO_ROOT,
    )
    return res.returncode


def commit_simple(message, amend=False):
    """Commit cho GUI: bat ca output (console co the dang an). Tra (ok, text)."""
    args = ["git", "commit", "-F", "-"] + (["--amend"] if amend else [])
    res = subprocess.run(
        args, input=message, cwd=REPO_ROOT,
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    out = (res.stdout + res.stderr).strip()
    return res.returncode == 0, out


def diff_stats(from_head=False):
    """(so file, dong them, dong bot) cua diff da stage (hoac HEAD khi amend)."""
    args = (["show", "--shortstat", "--format=", "HEAD"] if from_head
            else ["diff", "--staged", "--shortstat"])
    out = run_git(args, check=False)

    def grab(pattern):
        m = re.search(pattern, out)
        return int(m.group(1)) if m else 0

    return (grab(r"(\d+) files? changed"), grab(r"(\d+) insertion"),
            grab(r"(\d+) deletion"))


def branch_status():
    """Tra (branch, ahead): ahead = so commit chua push, None neu chua co upstream."""
    branch = run_git(["rev-parse", "--abbrev-ref", "HEAD"], check=False).strip()
    out = run_git(["rev-list", "--count", "@{u}..HEAD"], check=False).strip()
    ahead = int(out) if out.isdigit() else None
    return branch, ahead


def do_push():
    """git push; chua co upstream thi goi y push -u origin <branch>. True = ok."""
    print(c("Dang push...", "90"), file=sys.stderr)
    res = subprocess.run(
        ["git", "push"], cwd=REPO_ROOT,
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    out = (res.stdout + res.stderr).strip()
    if res.returncode == 0:
        print(out or "push xong.")
        return True
    if "--set-upstream" in out or "no upstream" in out:
        branch, _ = branch_status()
        try:
            ans = input(
                f"chua co upstream. Chay 'git push -u origin {branch}'? "
                + c("[Enter]", "1") + " dong y / " + c("[n]", "1") + " thoi: "
            ).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if ans in ("", "y", "yes"):
            res = subprocess.run(
                ["git", "push", "-u", "origin", branch], cwd=REPO_ROOT,
            )
            return res.returncode == 0
        return False
    err("push that bai:\n" + out)
    return False


def push_simple():
    """Push cho GUI: tu set upstream neu thieu, khong hoi input. Tra (ok, text)."""
    res = subprocess.run(
        ["git", "push"], cwd=REPO_ROOT,
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    out = (res.stdout + res.stderr).strip()
    if res.returncode == 0:
        return True, out or "push xong."
    if "--set-upstream" in out or "no upstream" in out:
        branch, _ = branch_status()
        res = subprocess.run(
            ["git", "push", "-u", "origin", branch], cwd=REPO_ROOT,
            capture_output=True, text=True, encoding="utf-8", errors="replace",
        )
        out2 = (res.stdout + res.stderr).strip()
        return res.returncode == 0, out2
    return False, out


def take_value(argv, *names):
    value, rest, i = None, [], 0
    while i < len(argv):
        a = argv[i]
        if a in names:
            if i + 1 >= len(argv):
                err(f"thieu gia tri cho {a} (vd: gcm {a} \"...\")")
                sys.exit(1)
            value = argv[i + 1]
            i += 2
            continue
        hit = next((n for n in names if a.startswith(n + "=")), None)
        if hit:
            value = a.split("=", 1)[1]
            i += 1
            continue
        rest.append(a)
        i += 1
    return value, rest


def edit_message(message):
    """Open the message in $EDITOR and return the edited text."""
    import tempfile
    editor = os.environ.get("EDITOR") or (
        "notepad" if os.name == "nt" else "nano"
    )
    with tempfile.NamedTemporaryFile(
        "w+", suffix=".gitcommit", delete=False
    ) as tf:
        tf.write(message)
        path = tf.name
    subprocess.run([editor, path])
    with open(path) as f:
        edited = f.read().strip()
    os.unlink(path)
    return edited


def self_update():
    """git pull trong thư mục cài gcm để lấy bản mới nhất."""
    src_dir = os.path.dirname(os.path.realpath(__file__))
    print(c(f"gcm v{VERSION} - cap nhat tai {src_dir} ...", "90"),
          file=sys.stderr)
    res = subprocess.run(
        ["git", "-C", src_dir, "pull", "--ff-only"],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
    )
    out = (res.stdout + res.stderr).strip()
    if out:
        print(out)
    if res.returncode != 0:
        err(f'cap nhat that bai. Thu thu cong: git -C "{src_dir}" pull')
        sys.exit(1)
    print(c("gcm da o ban moi nhat.", "32"))
    sys.exit(0)


def main():
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    enable_windows_ansi()

    # Config: chuyen file cu -> JSON, tao file mau khi chua co, roi don cac
    # key trung mac dinh (de doi mac dinh o ban sau la an ngay).
    global CONFIG, MODEL
    dirty = False
    migrated = migrate_legacy_config()
    if migrated:
        print(c(f"(config: da chuyen {LEGACY_CONFIG_PATH} -> {CONFIG_PATH}; "
                f"key giu lai: {', '.join(migrated) or 'khong co'})", "90"),
              file=sys.stderr)
        dirty = True
    dirty = ensure_user_config() or dirty
    pruned = prune_default_config()
    if pruned:
        print(c(f"(config: da bo {', '.join(pruned)} khoi config.json vi trung "
                f"mac dinh -> tu day dung built-in)", "90"), file=sys.stderr)
        dirty = True
    if dirty:
        CONFIG = load_config()
        MODEL = cfg("model")
    for w in CONFIG_WARNINGS:
        err(w)

    argv = sys.argv[1:]
    double_click = not argv and is_double_clicked()
    if argv == ["--gui"] or double_click:
        # An cua so console den khi double-click (chi Windows; an toan voi
        # subprocess git con vi chung tu tao console rieng neu can).
        ok, why = open_gui(hide_console=double_click)
        if not ok:
            err(f"khong mo duoc giao dien: {why}")
            sys.exit(1)
        return
    if "-h" in argv or "--help" in argv:
        print(c(LOGO, "36"))
        print(c(f"  gcm v{VERSION} — by devduide", "1"))
        print(__doc__)
        return
    if "-v" in argv or "--version" in argv:
        print(f"gcm v{VERSION}")
        return
    if "-u" in argv or "--update" in argv or (argv and argv[0] == "update"):
        self_update()
    if argv and argv[0] == "config":
        show_config(argv[1:])
    hint, argv = take_value(argv, "-m", "--hint")
    model_override, argv = take_value(argv, "--model")
    print_only = "-p" in argv or "--print" in argv
    # ngon ngu: config lang=vi -> mac dinh --vi; --en de ep lai English
    vietnamese = (
        "--vi" in argv
        or (cfg("lang") == "vi" and "--en" not in argv)
    )
    add_all = "-a" in argv or "--all" in argv
    select = "-s" in argv or "--select" in argv
    # tui: config tui=true -> mac dinh TUI; -s (nhap so) van uu tien hon
    tui = "-t" in argv or "--tui" in argv or (cfg("tui") and not select)
    auto_yes = "-y" in argv or "--yes" in argv
    amend = "--amend" in argv
    # push: --push hoac config push=always -> tu push sau commit
    push_cfg = cfg("push")
    auto_push = "--push" in argv or push_cfg == "always"
    no_push = push_cfg == "never"
    model = model_override or cfg("model")

    if not in_repo():
        # Chay ngoai repo (vd double-click, chay tu task runner nhu Cowork):
        # mo giao dien de chon repo thay vi thoat luon.
        print(c("khong o trong git repo -> mo giao dien de chon repo...", "90"),
              file=sys.stderr)
        ok, why = open_gui()
        if ok:
            return
        err("khong phai git repository (chay trong thu muc repo).")
        err(f"khong mo duoc giao dien de chon repo: {why}")
        sys.exit(1)

    def pick(default_all=False):
        """Chọn file: TUI nếu -t và hỗ trợ được, ngược lại chế độ nhập số."""
        if tui and tui_supported():
            try:
                return tui_select(default_all)
            except (OSError, ImportError):
                print(c("(TUI loi, chuyen sang nhap so)", "90"), file=sys.stderr)
        elif tui:
            print(c("(terminal khong ho tro TUI, dung nhap so)", "90"),
                  file=sys.stderr)
        return select_files(default_all)

    if add_all:
        run_git(["add", "-A"])
    elif tui or select:
        pick()

    def load_staged():
        d = run_git(["diff", "--staged"])
        fs = [
            ln for ln in run_git(["diff", "--staged", "--name-only"]).splitlines()
            if ln.strip()
        ]
        return d, fs

    diff, files = load_staged()
    from_head = False  # --amend khong stage gi: lay diff tu HEAD

    if not diff.strip():
        status = run_git(["status", "--porcelain"]).strip()
        if amend:
            diff = run_git(["show", "--format=", "HEAD"])
            files = [
                ln for ln in
                run_git(["show", "--name-only", "--format=", "HEAD"]).splitlines()
                if ln.strip()
            ]
            from_head = True
            if not diff.strip():
                err("khong co commit nao de --amend.")
                sys.exit(1)
        elif not status:
            err("nothing to commit (working tree clean).")
            sys.exit(1)
        elif print_only:
            err("chua stage thay doi nao. Dung `git add` hoac `gcm -a`.")
            sys.exit(1)
        else:
            pick(default_all=True)
            diff, files = load_staged()
            if not diff.strip():
                err("chua co file nao duoc stage.")
                sys.exit(1)

    api_key = get_api_key()

    # smart diff: loai lockfile/binary, file qua lon thay bang --stat
    diff, skipped, truncated = smart_diff(files, from_head)
    if not diff.strip():
        # toan bo deu bi loai (vd chi commit lockfile) -> gui stat tong
        diff = file_stat(".", from_head)

    def generate(temperature):
        if not print_only:
            print(c("Dang sinh commit message...", "90"), file=sys.stderr)
        system, user = build_prompt(diff, files, vietnamese, hint, skipped)
        return call_groq(api_key, system, user, model, temperature)

    message = generate(0.3)

    if print_only:
        print(message)
        return

    def finish(want_push):
        do_push_now = want_push and not no_push
        # chi them credit coauthor khi push code tu gcm (commit+push / --push)
        final = add_coauthor(message) if do_push_now else message
        rc = commit_with_message(final, amend)
        if rc != 0:
            sys.exit(rc)
        if do_push_now:
            do_push()
        sys.exit(0)

    if auto_yes:
        finish(auto_push)

    branch, ahead = branch_status()
    n_files, ins, dels = diff_stats(from_head)
    branch_line = c(f"nhanh {branch}", "36") + (
        c(f"  ↑{ahead} chua push", "33") if ahead else ""
    ) + c(f"  ·  {n_files} file  +{ins} −{dels}", "90")

    temperature = 0.3
    while True:
        print()
        print(branch_line)
        print(c("-" * 60, "90"))
        print(c(message, "32"))
        print(c("-" * 60, "90"))
        if truncated:
            print(c("(diff lon: mot phan chi gui thong ke --stat)", "90"))
        if skipped:
            print(c(f"(da loai khoi noi dung gui: {', '.join(skipped)})", "90"))

        action = " amend  " if amend else " commit  "
        prompt = c("[Enter]", "1") + action
        if not no_push:
            prompt += c("[p]", "1") + (" +push  " if amend else " commit+push  ")
        prompt += (
            c("[e]", "1") + " sua  "
            + c("[r]", "1") + " tao lai  "
            + c("[m]", "1") + " goi y  "
            + c("[d]", "1") + " diff  "
            + c("[n]", "1") + " huy: "
        )
        try:
            choice = input(prompt).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(1)

        if choice == "n":
            print("Da huy.")
            sys.exit(0)
        if choice == "r":
            temperature = min(temperature + 0.3, 1.0)
            message = generate(temperature)
            continue
        if choice == "m":
            # them/doi goi y roi sinh lai (nhu -m "..." nhung khong phai chay lai)
            try:
                new_hint = input(c("goi y cho AI (Enter = bo qua): ", "1")).strip()
            except (EOFError, KeyboardInterrupt):
                print()
                continue
            if new_hint:
                hint = new_hint
                temperature = 0.3
                message = generate(temperature)
            continue
        if choice == "d":
            if from_head:
                show_diff_text("diff commit HEAD (--amend)", run_git(
                    ["show", "--format=", "--no-color", "HEAD"], check=False))
            else:
                show_diff_text("diff da stage", run_git(
                    ["diff", "--staged", "--no-color"], check=False))
            continue
        if choice == "e":
            message = edit_message(message)
            if not message:
                err("message rong, da huy.")
                sys.exit(1)
        break

    finish(auto_push or choice == "p")


if __name__ == "__main__":
    main()
