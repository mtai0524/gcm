def get_system_prompt(vietnamese):
    """Tra ve system prompt da ap dung ngon ngu.

    Uu tien: file system_prompt.md > key "system_prompt" > mac dinh.
    """
    lang = "Viet bang TIENG VIET." if vietnamese else "Write in ENGLISH."

    template = None
    if os.path.exists(SYSTEM_PROMPT_PATH):
        try:
            with open(SYSTEM_PROMPT_PATH, encoding="utf-8",
                      errors="replace") as f:
                raw = f.read()
            # Bo cac khoi comment HTML <!-- ... --> (ghi chu cho nguoi dung)
            template = re.sub(r"<!--.*?-->", "", raw, flags=re.DOTALL).strip()
            template = template or None
        except OSError:
            template = None
    if template is None:
        template = cfg("system_prompt").strip() or None
    if template is None:
        template = DEFAULT_SYSTEM_PROMPT

    if "{lang}" in template:
        return template.replace("{lang}", lang)
    return template.rstrip() + " " + lang


