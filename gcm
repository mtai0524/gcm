def show_config(args=()):
    """`gcm config` - xem/sua config, luon chi ro tung key den tu dau.

    gcm config              bang config hieu luc + nguon (mac dinh/file/env)
    gcm config set KEY VAL  ghi vao config.json (trung mac dinh -> xoa khoi file)
    gcm config unset KEY    bo override, quay ve mac dinh built-in
    gcm config path         in duong dan file config
    """
    args = list(args)
    if args and args[0] == "path":
        print(CONFIG_PATH)
        sys.exit(0)
    if args and args[0] in ("set", "unset"):
        action, rest = args[0], args[1:]
        if not rest or (action == "set" and len(rest) < 2):
            err("dung: gcm config " + action + " KEY"
                + (" VALUE" if action == "set" else ""))
            print(c("key hop le: " + ", ".join(CONFIG_KEYS), "90"),
                  file=sys.stderr)
            sys.exit(1)
        key = rest[0].strip().lower()
        try:
            if action == "set":
                save_config(key, " ".join(rest[1:]))
                shown = "***" if key in SECRET_KEYS else repr(cfg(key))
                if config_source(key) == "mac dinh":
                    # Trung mac dinh built-in -> khong ghim vao file lam gi.
                    print(c(f"{key} = {shown}", "32")
                          + c(" = mac dinh built-in -> khong ghi vao file",
                              "90"))
                else:
                    print(c(f"da ghi: {key} = {shown}", "32")
                          + c(f"  <- {config_source(key)}", "90"))
            else:
                removed = unset_config(key)
                state = "da bo override" if removed else "khong co trong file"
                print(c(f"{key}: {state}", "32")
                      + c(f" -> mac dinh {CONFIG_DEFAULTS[key]!r}", "90"))
        except (KeyError, ValueError) as e:
            err(e.args[0] if e.args else str(e))
            print(c("key hop le: " + ", ".join(CONFIG_KEYS), "90"),
                  file=sys.stderr)
            sys.exit(1)
        sys.exit(0)
    if args:
        err(f"khong hieu 'gcm config {args[0]}' (dung: set | unset | path)")
        sys.exit(1)

    print(c("config: ", "1") + CONFIG_PATH
          + ("" if os.path.exists(CONFIG_PATH) else c("  (chua co file)", "90")))
    width = max(len(k) for k in CONFIG_KEYS)
    for k in CONFIG_KEYS:
        v = cfg(k)
        if k in SECRET_KEYS and isinstance(v, str) and len(v) > 8:
            v = v[:7] + "..." + v[-4:]
        if isinstance(v, str) and len(v) > 60:
            v = v[:57] + "..."
        src = config_source(k)
        print(f"  {k.ljust(width)}  " + c(repr(v), "90" if src == "mac dinh"
                                          else "0")
              + c(f"  <- {src}", "90"))
    if not resolve_api_key():
        err("chua co api key - lay free tai https://console.groq.com/keys")
    elif config_source("api_key") == "mac dinh" and EMBEDDED_API_KEY:
        print(c("  (api_key dang lay tu key nhung san trong ban build)", "90"))
    if os.path.exists(SYSTEM_PROMPT_PATH):
        sp_src = f"file ({SYSTEM_PROMPT_PATH})"
    elif cfg("system_prompt").strip():
        sp_src = "config 'system_prompt'"
    else:
        sp_src = "mac dinh (built-in)"
    print(c("system prompt: ", "1") + sp_src)
    print(c("sua: gcm config set KEY VALUE  |  gcm config unset KEY  |  hoac "
            "mo thang config.json", "90"))
    print(c("file mau day du: "
            + os.path.join(os.path.dirname(CONFIG_PATH),
                           "config.example.json"), "90"))
    sys.exit(0)


# ---- small terminal color helpers ----
def enable_windows_ansi():
    """Bat xu ly ma mau ANSI tren console Windows cu (conhost).

    Khong co buoc nay, mau se hien thanh chu rac kieu '<-[31m'. Windows
    Terminal moi thi mac dinh hieu ANSI nen buoc nay vo hai o do.
    """
    if os.name != "nt":
        return
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        ENABLE_VT = 0x0004
        for handle_id in (-11, -12):  # STDOUT, STDERR
            handle = kernel32.GetStdHandle(handle_id)
            mode = ctypes.c_uint32()
            if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
                kernel32.SetConsoleMode(handle, mode.value | ENABLE_VT)
    except Exception:
        pass


def _launcher_process_name():
    """Ten tien trinh da khoi chay ta, bo qua cac 'gcm.exe' bootloader (Windows).

    PyInstaller --onefile chay 2 tien trinh cung ten gcm.exe (bootloader cha +
    con). Di nguoc cay tien trinh, bo qua chung, tra ve ten (lowercase) cua to
    tien dau tien khac gcm.exe: 'explorer.exe' (double-click) hay 'powershell.exe'
    / 'cmd.exe' / ... (terminal). Tra None neu khong xac dinh duoc.
    """
    import ctypes

    class PROCESSENTRY32(ctypes.Structure):
        _fields_ = [
            ("dwSize", ctypes.c_uint32),
            ("cntUsage", ctypes.c_uint32),
            ("th32ProcessID", ctypes.c_uint32),
            ("th32DefaultHeapID", ctypes.c_void_p),
            ("th32ModuleID", ctypes.c_uint32),
            ("cntThreads", ctypes.c_uint32),
            ("th32ParentProcessID", ctypes.c_uint32),
            ("pcPriClassBase", ctypes.c_long),
            ("dwFlags", ctypes.c_uint32),
            ("szExeFile", ctypes.c_char * 260),
        ]

    k = ctypes.windll.kernel32
    k.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
    k.CreateToolhelp32Snapshot.argtypes = [ctypes.c_uint32, ctypes.c_uint32]
    k.Process32First.argtypes = [ctypes.c_void_p, ctypes.POINTER(PROCESSENTRY32)]
    k.Process32Next.argtypes = [ctypes.c_void_p, ctypes.POINTER(PROCESSENTRY32)]

    snap = k.CreateToolhelp32Snapshot(0x00000002, 0)  # TH32CS_SNAPPROCESS
    if not snap or snap == ctypes.c_void_p(-1).value:
        return None
    try:
        entry = PROCESSENTRY32()
        entry.dwSize = ctypes.sizeof(PROCESSENTRY32)
        info = {}  # pid -> (parent_pid, exe_name_lower)
        if k.Process32First(snap, ctypes.byref(entry)):
            while True:
                name = entry.szExeFile.decode("ascii", "replace").lower()
                info[entry.th32ProcessID] = (entry.th32ParentProcessID, name)
                if not k.Process32Next(snap, ctypes.byref(entry)):
                    break
    finally:
        k.CloseHandle(snap)

    cur, seen = os.getpid(), set()
    while cur in info and cur not in seen:
        seen.add(cur)
        parent_pid, _ = info[cur]
        parent = info.get(parent_pid)
        if parent is None:
            return None
        if parent[1] == "gcm.exe":
            cur = parent_pid
            continue
        return parent[1]
    return None


def is_double_clicked():
    """True neu exe duoc mo bang double-click trong Explorer (Windows).

    Cach chinh: xem to tien khoi chay co phai explorer.exe khong (chinh xac,
    khong phu thuoc so dem). Fallback: dem tien trinh gan console - voi
    --onefile, double-click thuong cho 1-2 (chi cac gcm.exe), terminal >2 vi
    co them shell. Non-Windows luon tra False.
    """
    if os.name != "nt":
        return False
    try:
        import ctypes
        launcher = _launcher_process_name()
        if launcher is not None:
            return launcher == "explorer.exe"
        arr = (ctypes.c_uint32 * 4)()
        count = ctypes.windll.kernel32.GetConsoleProcessList(arr, 4)
        return 0 < count <= 2
    except Exception:
        return False


def open_gui(hide_console=False):
    """Mo giao dien Tkinter. Tra (ok, ly_do_that_bai).

    hide_console: chi dung khi double-click tren Windows - go cua so console
    den di. Khi chay tu terminal thi giu console lai de con in log.
    Khong mo duoc (thieu tkinter, khong co man hinh...) -> (False, ly do)
    de nguoi goi quay ve duong CLI.
    """
    if hide_console and os.name == "nt":
        try:
            import ctypes
            ctypes.windll.kernel32.FreeConsole()
        except Exception:
            pass
    try:
        import gcm_gui
    except ImportError as e:
        return False, str(e)
    try:
        gcm_gui.run_gui(sys.modules[__name__])
    except Exception as e:  # tkinter.TclError khi khong co man hinh (SSH/CI)
        return False, str(e)
    return True, ""


def c(text, code):
    try:
        if not sys.stdout.isatty():
            return text
    except (AttributeError, ValueError, OSError):
        # stdout = None (pythonw) hoac console da bi FreeConsole -> khong mau
        return text
    return f"\033[{code}m{text}\033[0m"


def err(msg):
    if sys.stderr is None:
        return
    print(c("error: ", "31") + msg, file=sys.stderr)


def run_git(args, check=True):
    """Run a git command, return stdout (stripped)."""
    res = subprocess.run(
        ["git"] + args,
        capture_output=True, text=True,
        encoding="utf-8", errors="replace",
        cwd=REPO_ROOT,
    )
    if check and res.returncode != 0:
        err(res.stderr.strip() or f"git {' '.join(args)} failed")
        sys.exit(1)
    return res.stdout


def resolve_api_key():
    """Key theo thu tu: env > config.json > key nhung san luc build.

    Doc env trong ham (khong chi dua vao CONFIG) de env luon thang ke ca khi
    CONFIG duoc nap tu truoc. Tra '' neu chua co key nao.
    """
    return (os.environ.get("GROQ_API_KEY", "").strip()
            or cfg("api_key")
            or EMBEDDED_API_KEY)


