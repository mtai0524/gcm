def sync_config_hints():
    """Cap nhat cac dong ghi chu '//key' trong config.json theo schema.

    Chi dung toi key bat dau bang '//' - gia tri that cua nguoi dung KHONG bao
    gio bi dung toi. Nho vay mo file ra luon thay du moi truong + mac dinh
    hien tai, ke ca sau khi nang cap gcm. Tra True neu co sua file.
    """
    raw = read_config_raw()
    if "//" not in raw:  # nguoi dung da don sach ghi chu -> ton trong
        return False
    wanted = {f"//{k}": config_hint(k) for k in CONFIG_SCHEMA}
    if all(raw.get(k) == v for k, v in wanted.items()):
        return False
    raw.update(wanted)
    try:
        write_config_file(raw)
    except OSError:
        return False
    return True


def ensure_user_config():
    """Tao thu muc config + config.json + cac file mau khi chua co.

    Dam bao moi cach cai (MSI/pip/bash) deu co san file de nguoi dung sua.
    Khong ghi de config.json da ton tai (chi lam moi dong ghi chu '//key').
    Tra True neu vua tao config.json.
    """
    created = False
    cfg_dir = os.path.dirname(CONFIG_PATH)
    try:
        os.makedirs(cfg_dir, exist_ok=True)
        if not os.path.exists(CONFIG_PATH):
            data = config_skeleton()
            data["api_key"] = ""  # cho san cho de dan key vao
            write_config_file(data)
            created = True
        else:
            sync_config_hints()
        example = os.path.join(cfg_dir, "config.example.json")
        with open(example, "w", encoding="utf-8") as f:  # luon lam moi theo schema
            json.dump(config_example_data(), f, indent=2, ensure_ascii=False)
            f.write("\n")
        sp_example = os.path.join(cfg_dir, "system_prompt.example.md")
        if not os.path.exists(sp_example):
            header = (
                "<!-- gcm system prompt mau.\n"
                "Copy sang system_prompt.md (cung thu muc) de dung lam prompt:\n"
                "  Windows: copy system_prompt.example.md system_prompt.md\n"
                "  Linux/macOS: cp system_prompt.example.md system_prompt.md\n"
                "Khi system_prompt.md ton tai, gcm dung no thay prompt mac dinh.\n"
                "{lang} = cau chi dinh ngon ngu (theo --vi/--en). -->\n"
            )
            with open(sp_example, "w", encoding="utf-8") as f:
                f.write(header + DEFAULT_SYSTEM_PROMPT + "\n")
    except OSError:
        pass
    return created


