def in_repo():
    """True neu thu muc hien tai nam trong git work tree (set REPO_ROOT)."""
    global REPO_ROOT
    res = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree", "--show-toplevel"],
        capture_output=True, text=True,
        encoding="utf-8", errors="replace",
    )
    lines = res.stdout.splitlines()
    if res.returncode != 0 or not lines or lines[0].strip() != "true":
        return False
    REPO_ROOT = lines[1].strip() if len(lines) > 1 else None
    return True


def set_repo(folder):
    """Chuyen sang thu muc repo cho GUI (khong sys.exit).

    Tra (ok, error_msg). Khi ok, doi cwd va set REPO_ROOT = toplevel.
    """
    global REPO_ROOT
    if not folder or not os.path.isdir(folder):
        return False, "thu muc khong ton tai"
    res = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree", "--show-toplevel"],
        cwd=folder, capture_output=True, text=True,
        encoding="utf-8", errors="replace",
    )
    lines = res.stdout.splitlines()
    if res.returncode != 0 or not lines or lines[0].strip() != "true":
        return False, "khong phai git repository"
    top = lines[1].strip() if len(lines) > 1 else folder
    os.chdir(top)
    REPO_ROOT = top
    return True, ""


def changed_files():
    items = []
    for line in run_git(["status", "--porcelain", "-uall"]).splitlines():
        if not line.strip():
            continue
        code = line[:2]
        rest = line[3:]
        if " -> " in rest:
            rest = rest.split(" -> ", 1)[1]
        rest = rest.strip()
        if len(rest) >= 2 and rest[0] == '"' and rest[-1] == '"':
            rest = rest[1:-1].encode().decode("unicode_escape")
        items.append((code, rest))
    return items


def stage_files(selected, all_changed):
    """Stage cac file trong `selected`, unstage phan con lai trong `all_changed`.

    Dam bao `git diff --staged` chi chua dung cac file nguoi dung tick.
    """
    selected = set(selected)
    to_add = [p for p in all_changed if p in selected]
    to_reset = [p for p in all_changed if p not in selected]
    if to_add:
        run_git(["add", "--", *to_add])
    if to_reset:
        run_git(["reset", "-q", "--", *to_reset], check=False)


def status_label(code):
    if code == "??":
        return c("new      ", "36")
    flags = code.replace(" ", "")
    if "D" in flags:
        return c("deleted  ", "31")
    if "R" in flags:
        return c("renamed  ", "35")
    if "A" in flags:
        return c("added    ", "32")
    if "M" in flags:
        return c("modified ", "33")
    return c(code.ljust(9), "90")


def parse_pick(raw, n):
    """Phan tich lua chon: '1 3', '2-5', 'a', '-2' (loai), 'a -2 -4'.

    Tra list so (1-based) da sap xep; [] neu khong chon gi; None neu co token
    khong hieu. Chi co token loai (-N) thi hieu la 'tat ca tru N'.
    """
    include, exclude, saw_include = set(), set(), False

    def span(tok):
        if tok.isdigit():
            return [int(tok)]
        a, _, b = tok.partition("-")
        if a.isdigit() and b.isdigit():
            return list(range(int(a), int(b) + 1))
        return None

    for tok in raw.replace(",", " ").split():
        if tok in ("a", "all", "*"):
            include |= set(range(1, n + 1))
            saw_include = True
            continue
        target, neg = (exclude, True) if tok.startswith("-") else (include, False)
        nums = span(tok[1:] if neg else tok)
        if nums is None:
            return None
        target |= {k for k in nums if 1 <= k <= n}
        saw_include = saw_include or not neg
    if not saw_include and exclude:
        include = set(range(1, n + 1))
    return sorted(include - exclude)


def show_diff_text(title, text):
    """Xem mot doan diff: pager cuon duoc neu terminal cho phep, khong thi in."""
    lines = [c(ln, _DIFF_COLORS[k]) if k in _DIFF_COLORS else ln
             for k, ln in classify_diff(text)] or [c("(khong co gi)", "90")]
    if tui_supported():
        pager(title, lines)
    else:
        print(c(f"--- {title} ---", "1"))
        print("\n".join(lines))


def view_file_diff(code, path):
    """Xem diff 1 file trong bo chon: pager neu duoc, khong thi in ra."""
    if tui_supported():
        diff_pager(code, path)
        return
    title, lines = diff_lines(code, path)
    print(c(f"--- {title} ---", "1"))
    print("\n".join(lines[:80]))
    if len(lines) > 80:
        print(c(f"... ({len(lines) - 80} dong nua)", "90"))


PICK_HELP = (
    "  so ('1 3', '2-5') chon dung cac file do . 'a' tat ca . '-2' bo file 2\n"
    "  'i' dao trang thai stage . 'd 3' xem diff file 3 ('d' = toan bo)\n"
    "  't' mo bo chon TUI . Enter = {enter} . 'q' huy"
)


def select_files(default_all=False):
    """Bo chon file nhap so (che do `gcm` thuong).

    Lenh: so/khoang ('1 3', '2-5'), 'a' tat ca, '-N' loai N, 'i' dao, 'd N'
    xem diff, 't' sang TUI, '?' tro giup, Enter giu nguyen/tat ca, 'q' huy.
    Chon xong thi stage DUNG tap da chon (file ● da stage ma khong chon se
    duoc unstage). Tra True neu co stage, False neu giu nguyen.
    """
    items = changed_files()
    if not items:
        return False
    n = len(items)
    branch, ahead = branch_status()
    all_paths = [p for _, p in items]

    def staged_idx():
        return {i for i, (code, _) in enumerate(changed_files())
                if code[0] not in " ?"}

    def show(staged, full_help=False):
        cols = term_size()[0]
        head = f"[{branch}" + (f" ↑{ahead}" if ahead else "") + "]"
        print(c(head, "36") + c(f" Chon file de stage ({n} thay doi"
                                + (f", {len(staged)} da stage" if staged
                                   else "") + "):", "1"))
        path_w = max(20, cols - 22)
        for i, (code, path) in enumerate(items, 1):
            mark = c("\u25cf", "32") if (i - 1) in staged else c("\u25cb", "90")
            print(f"  {mark} {c(str(i).rjust(2) + '.', '1')} "
                  f"{status_label(code)} {shorten_path(path, path_w)}")
        enter = "tat ca" if (default_all or not staged) else "giu nguyen (●)"
        text = PICK_HELP.format(enter=enter)
        print(c(text if full_help else text.splitlines()[0]
                + f" . 'i' dao . 'd 3' diff . '?' them . Enter = {enter} . 'q' huy",
                "90"))

    staged = staged_idx()
    full_help = False
    while True:
        show(staged, full_help)
        full_help = False
        try:
            raw = input(c("> ", "1")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(1)

        if raw in ("q", "quit", "n"):
            print("Da huy.")
            sys.exit(0)
        if raw in ("?", "h", "help"):
            full_help = True
            continue
        if raw == "t":
            if tui_supported():
                return tui_select(default_all)
            print(c("terminal khong ho tro TUI (can tty).", "90"))
            continue
        if raw == "d" or raw.startswith("d "):
            arg = raw[1:].strip()
            if not arg:
                show_diff_text("diff da stage", run_git(
                    ["diff", "--staged", "--no-color"], check=False))
            elif arg.isdigit() and 1 <= int(arg) <= n:
                view_file_diff(*items[int(arg) - 1])
            else:
                err(f"dung: d <so 1-{n}>")
            continue
        if raw == "":
            if default_all or not staged:
                chosen = list(range(1, n + 1))
            else:
                return False  # giu nguyen nhung gi da stage
        elif raw == "i":
            chosen = [i + 1 for i in range(n) if i not in staged]
            if not chosen:
                err("dao xong thi khong con file nao - chon lai.")
                continue
        else:
            chosen = parse_pick(raw, n)
            if chosen is None:
                err("khong hieu. Go ? de xem huong dan.")
                continue
            if not chosen:
                err("khong chon file nao hop le.")
                continue
        paths = [items[i - 1][1] for i in chosen]
        stage_files(paths, all_paths)
        print(c(f"da stage {len(paths)} file:", "32"),
              c(", ".join(paths) if len(paths) <= 6 else
                ", ".join(paths[:6]) + f", ... (+{len(paths) - 6})", "90"))
        return True


def tui_supported():
    """TUI cần stdin/stdout là tty và có module đọc phím raw."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        if os.name == "nt":
            import msvcrt  # noqa: F401
        else:
            import termios, tty  # noqa: F401
        return True
    except ImportError:
        return False


